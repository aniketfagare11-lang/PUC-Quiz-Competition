# ---- Server ----
PORT=5000

# ---- Database (MongoDB Atlas) ----
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/avishkar_quiz?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/avishkar_quiz

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string

# ---- Admin (created by `npm run seed`) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Quiz config ----
ROUND1_TIME_LIMIT_SECONDS=3000

# ---- CORS (comma-separated frontend origins) ----
CLIENT_URL=http://localhost:5173
