# ---- Server ----
PORT=5000

# ---- Database (MongoDB Atlas) ----
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quizarena?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27018/quizarena

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string

# ---- Admin (created by `npm run seed`) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Competition config ----
TOTAL_TEAMS=16
ROUND1_TIME_LIMIT_SECONDS=1200
ROUND2_TIME_LIMIT_SECONDS=1200

# ---- CORS (comma separated; leave empty for open in dev) ----
CLIENT_URL=http://localhost:5173
